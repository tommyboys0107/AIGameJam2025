      "top": { "x": "random", "y": -50 },
      "left": { "x": -50, "y": "random" },
      "right": { "x": "screenWidth + 50", "y": "random" }
    }
  },
  "corruptionSettings": {
    "maxCorruption": 100,
    "corruptionThresholds": {
      "warning": 60,
      "critical": 80,
      "gameOver": 100
