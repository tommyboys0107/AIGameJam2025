    "corruptionPenalties": {
      "missedCorrupted": 15,
      "falsePositive": 10,
      "timeoutPenalty": 5
    },
    "corruptionProbability": {
      "phase1": 0.3,
      "phase2": 0.4,
      "phase3": 0.5,
      "maxProbability": 0.7
    }
  },
  "difficultyScaling": {
    "speedMultiplierPerPhase": 1.2,
    "spawnRateMultiplierPerPhase": 1.15,
    "corruptionProbabilityIncrease": 0.05,
    "maxSpeedMultiplier": 3.5,
    "maxSpawnRateMultiplier": 3.0
  },
  "uiSettings": {
    "colors": {
      "background": "#000000",
      "neonGreen": "#00FF41",
      "electronicBlue": "#00BFFF",
      "warningRed": "#FF0040",
      "corruptionRed": "#FF1744"
    },
    "animations": {
      "flickerDuration": 0.2,
      "glitchEffectDuration": 0.5,
      "fadeTransitionDuration": 0.3
