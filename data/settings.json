  "audioSettings": {
    "masterVolume": 0.7,
    "sfxVolume": 0.8,
    "soundEffects": {
      "click": "assets/audio/click.wav",
      "block": "assets/audio/block.wav",
      "phaseChange": "assets/audio/phase_change.wav",
      "corruption": "assets/audio/corruption.wav",
      "gameOver": "assets/audio/game_over.wav",
      "success": "assets/audio/success.wav"
